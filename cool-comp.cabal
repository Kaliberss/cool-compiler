cabal-version:      3.0
name:               cool-comp
version:            0.1.0

executable cool-comp
    main-is:        Main.hs
    
    other-modules:  Lexer, AST, Parser, Utils, Semantic

    build-depends:  base >= 4.14 && < 4.21, megaparsec ^>= 9.6, parser-combinators ^>=1.3, containers^>=0.7, pretty-show, mtl ^>=2.3.1

    default-language: GHC2021
